EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Clerk Dashboard -> API Keys -> Secret keys. Server-only: verifies the signed-in user
# inside app/api/**/+api.ts (see lib/stream-server.ts). Never prefix with EXPO_PUBLIC_.
CLERK_SECRET_KEY=sk_test_your_secret_key_here

EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Stream Dashboard -> your app -> API keys. Server-only: used by app/api/stream/**/+api.ts
# to mint user tokens and create calls. Never prefix with EXPO_PUBLIC_.
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# Base URL of the vision-agent service (see vision-agent/README.md). Server-only: used by
# app/api/agent-session+api.ts to start/stop the AI teacher. Never prefix with EXPO_PUBLIC_.
VISION_AGENT_URL=http://localhost:8000
